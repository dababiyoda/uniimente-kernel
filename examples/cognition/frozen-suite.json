{
  "version": "1.0",
  "scope": "explicit typed operations and bounded supplied data; not natural-language inference or external outcome proof",
  "baseline_required_for_superiority": [
    "always raw local LLM",
    "strongest eligible licensed local LLM",
    "LLM router",
    "best eligible specialized solver",
    "strongest simple baseline"
  ],
  "baseline_availability": "UNAVAILABLE here; record no superiority/regret estimate until all required predeclared comparisons are measured",
  "cases": [
    {
      "id": "bounded:calculate",
      "request": {
        "problem_id": "test:calculate",
        "operation": "calculate",
        "data": {
          "expression": "0.1 + 0.2"
        }
      },
      "expected": {
        "method": "cognition.exact",
        "state": "NONE",
        "output": {
          "exact": "3/10"
        }
      }
    },
    {
      "id": "bounded:polynomial",
