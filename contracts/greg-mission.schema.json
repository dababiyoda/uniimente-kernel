{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniimente.internal/contracts/greg-mission.schema.json",
  "title": "GREG persistent mission (founder-signed MISSION command body)",
  "description": "A durable target state, the checks that observe it, candidate strategies, and the bounded light cone inside which GREG may pursue it. Registration grants no authority; every action still crosses the Kernel Consequence Gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "founder_expression",
    "intended_effect",
    "closure",
    "success_checks",
    "strategies",
    "light_cone",
    "priority"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "pattern": "^m:[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "founder_expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "intended_effect": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "beneficiaries": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "maxItems": 50
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "unacceptable_outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "bounded",
            "infinite"
          ]
        },
        "ladder": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "maxItems": 100
        },
        "cadence_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        }
      }
    },
    "success_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "description",
          "sensor",
          "predicate"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]{1,80}$"
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "sensor": {
            "$ref": "#/$defs/invocation"
          },
          "predicate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "exists",
                  "absent",
                  "equals",
                  "contains",
                  "not_contains",
                  "gte",
                  "lte",
                  "count_gte"
                ]
              },
              "field": {
                "type": "string",
                "maxLength": 200
              },
              "value": {}
            }
          }
        }
      }
    },
    "strategies": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "advances",
          "target",
          "rationale"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]{1,80}$"
          },
          "capability": {
            "type": "string",
            "maxLength": 120
          },
          "function": {
            "type": "string",
            "maxLength": 120
          },
          "params": {
            "type": "object"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "advances": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000
          },
          "expected_outcome": {
            "type": "string",
            "maxLength": 500
          },
          "evidence_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "requires": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]{1,80}$"
            },
            "description": "check_ids that must be observed passing before this strategy may act (e.g. file a verification record only after the digest matched)"
          },
          "compensate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "target"],
            "description": "the compensating action signed with this strategy. If the mission is abandoned after this strategy executed, it runs once through the Gate, bound to the original receipt; if it is superseded, it runs only after the founder approves that exact scope (a successor may rely on the effect). Its result is the Gate's receipt; the undone state is not independently re-observed. It runs unpaid (cost 0), so a capability that spends money by itself (worker.commission) is refused here; one compensation is dispatched per mission step, and a founder answer to the effect's COMPENSATION ask closes it. It must sit inside the mission's light cone: capability and target admitted, and the capability's consequence class within the ceiling (checked at registration).",
            "properties": {
              "capability": {"type": "string", "maxLength": 120},
              "params": {"type": "object"},
              "target": {"type": "string", "minLength": 1, "maxLength": 500}
            }
          },
          "bind": {
            "type": "array",
            "maxItems": 8,
            "description": "typed output->input edges: a param of this strategy is taken from a field of the latest DONE Gate receipt of another strategy in the same signed mission. The value is data: target, capability, cost and consequence class stay as signed, and the bound params enter the scope digest, so an approval covers the exact bound content.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "param",
                "from",
                "type"
              ],
              "properties": {
                "param": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]{1,64}(\\.[A-Za-z0-9_]{1,64}){0,5}$"
                },
                "from": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "action_id: the latest DONE receipt of that strategy. check_id: the receipt of the latest passing observation of a check this strategy requires (the exact evidence that satisfied its precondition).",
                  "required": [
                    "field"
                  ],
                  "oneOf": [
                    {"required": ["action_id"]},
                    {"required": ["check_id"]}
                  ],
                  "properties": {
                    "action_id": {
                      "type": "string",
                      "pattern": "^[a-z0-9_.-]{1,80}$"
                    },
                    "check_id": {
                      "type": "string",
                      "pattern": "^[a-z0-9_.-]{1,80}$"
                    },
                    "field": {
                      "type": "string",
                      "maxLength": 300
                    }
                  }
                },
                "type": {
                  "enum": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "object",
                    "array"
                  ]
                },
                "render": {
                  "enum": [
                    "value",
                    "json"
                  ],
                  "description": "json: the value as sorted JSON text"
                },
                "template": {
                  "type": "string",
                  "maxLength": 4000,
                  "description": "text with exactly one {value} placeholder"
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1048576,
                  "description": "at most 65536 unless by is artifact"
                },
                "by": {
                  "enum": [
                    "receipt",
                    "artifact"
                  ],
                  "description": "receipt (default): the value the receipt kept; a value the receipt cut is refused. artifact: when the receipt cut the output, the whole output is read from the body's artifact store by the address the receipt recorded and re-hashed; a missing or altered artifact holds the strategy. Default max_bytes 1048576."
                }
              }
            }
          },
          "declined_if": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sensor",
              "predicate"
            ],
            "description": "Only for a person's step (human.* or professional.*): the read-only observation that the person declined. When it holds, GREG records the refusal as legitimate, withdraws its ask, never pursues this step again in the mission and asks the founder how to proceed.",
            "properties": {
              "sensor": {
                "$ref": "#/$defs/invocation"
              },
              "predicate": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op"
                ],
                "properties": {
                  "op": {
                    "enum": [
                      "exists",
                      "absent",
                      "equals",
                      "contains",
                      "not_contains",
                      "gte",
                      "lte",
                      "count_gte"
                    ]
                  },
                  "field": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "value": {}
                }
              }
            }
          }
        }
      }
    },
    "light_cone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "targets",
        "max_consequence_class",
        "budget_usd",
        "horizon"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 200
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "minItems": 1,
          "maxItems": 200
        },
        "max_consequence_class": {
          "enum": [
            "read_only",
            "internal_write",
            "external_contact"
          ]
        },
        "budget_usd": {
          "type": "number",
          "minimum": 0
        },
        "horizon": {
          "type": "string",
          "format": "date-time"
        },
        "data_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "auto_attach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_consequence_class"
      ],
      "properties": {
        "max_consequence_class": {
          "enum": [
            "read_only"
          ]
        }
      }
    },
    "standing_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consequence_inert"
      ],
      "properties": {
        "consequence_inert": {
          "const": true
        }
      },
      "description": "Founder-signed standing mandate: an interrupted dispatch that the retained facts prove consequence-inert (greg.workers.inert_interruption_proof) is settled with its proof and retried once, at most twice per action. Anything else still asks the founder."
    },
    "value_per_check_usd": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000,
      "description": "Founder-stated value of closing one failing check, used only to rank strategies against spend."
    },
    "venture": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
      "description": "The venture this mission serves (a short name). Books and capability transfer are measured per venture (greg/venture_books.py); it grants nothing."
    },
    "pre_approved_steps": {
      "type": "array",
      "maxItems": 200,
      "description": "Steps this founder signature approves in advance, one exact strategy each (a run of a ratified SOP, greg/sop.py). Each admits only its own strategy, with this capability, target and consequence class at no cost, past the light cone; it never widens the cone for any other strategy and never answers a constitutional requirement for a human.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "capability", "target", "consequence_class", "cost_usd"],
        "properties": {
          "action_id": {"type": "string", "pattern": "^[a-z0-9_.-]{1,80}$"},
          "capability": {"type": "string", "maxLength": 120},
          "target": {"type": "string", "minLength": 1, "maxLength": 500},
          "consequence_class": {"enum": ["read_only", "internal_write"]},
          "cost_usd": {"const": 0}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "planner"
      ],
      "description": "How this mission proposal was produced (template or model). Founder-signed as part of the body; it is attribution, never authority.",
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 200
        },
        "planner": {
          "type": "string",
          "maxLength": 100
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "clamped": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "maxItems": 20
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0,
          "description": "Model calls GREG made to produce this proposal (0 for templates and ratified SOPs)."
        },
        "model_cost_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Provider-reported model spend to produce this proposal; absent when the route did not report it."
        },
        "procedure_id": {
          "type": "string",
          "pattern": "^sop-[0-9a-f]{16}$",
          "description": "The ratified SOP this mission is one run of (greg/sop.py)."
        },
        "ratification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Digest of the founder-signed SOP_RATIFY command whose workflow produced this mission."
        },
        "inputs": {
          "type": "object",
          "maxProperties": 30,
          "description": "The normalized inputs a template built this mission from; attribution that lets a ratified procedure ask only for them (greg/sop.py).",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          }
        },
        "slots": {
          "type": "object",
          "maxProperties": 50,
          "description": "The values this run gave the ratified workflow's slots.",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          }
        },
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "served_model": {
          "type": "string",
          "maxLength": 200,
          "description": "Model the provider reported actually serving the answer; may differ from the route's requested model."
        },
        "requested_model": {
          "type": "string",
          "maxLength": 200,
          "description": "Model the route asked for (the founder's selection); recorded next to served_model."
        },
        "substituted": {
          "type": "boolean",
          "description": "Whether a model other than requested_model answered; absent when the route did not or could not check."
        },
        "model_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "Local model artifact digest reported by the explicitly selected on-device provider."
        },
        "routes_tried": {
          "type": "array",
          "maxItems": 10,
          "description": "Model routes attempted before the author route answered (outages and skips); attribution only.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "route",
              "outcome"
            ],
            "properties": {
              "route": {
                "type": "string",
                "maxLength": 200
              },
              "outcome": {
                "enum": [
                  "ok",
                  "failed",
                  "skipped",
                  "refused"
                ]
              },
              "class": {
                "type": "string",
                "maxLength": 60,
                "description": "greg.models failure class (transient, auth, capability_unavailable, invalid_request, bad_output, safety_refusal, provider_policy_refusal, unknown)."
              },
              "why": {
                "type": "string",
                "maxLength": 300
              },
              "cost_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "What a failed or refused attempt was still billed, booked against the budget; null when the provider reported none."
              }
            }
          }
        }
      }
    },
    "capability_specs": {
      "type": "array",
      "maxItems": 10,
      "description": "Founder-frozen contracts for functions GREG may have built if nothing existing can perform them. Public examples are shown to the builder; held_out vectors never are. Building is paid from build_budget_usd, which must fit inside the light-cone budget.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "function",
          "description",
          "output_field",
          "examples",
          "held_out",
          "build_budget_usd"
        ],
        "properties": {
          "function": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          },
          "returns": {
            "type": "string",
            "maxLength": 200
          },
          "output_field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,40}$"
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_text",
                "expected"
              ],
              "properties": {
                "input_text": {
                  "type": "string",
                  "maxLength": 20000
                },
                "expected": {}
              }
            }
          },
          "held_out": {
            "type": "array",
            "minItems": 3,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_text",
                "expected"
              ],
              "properties": {
                "input_text": {
                  "type": "string",
                  "maxLength": 20000
                },
                "expected": {}
              }
            }
          },
          "build_budget_usd": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          }
        }
      }
    }
  },
  "$defs": {
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "maxLength": 120
        },
        "function": {
          "type": "string",
          "maxLength": 120
        },
        "params": {
          "type": "object"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
