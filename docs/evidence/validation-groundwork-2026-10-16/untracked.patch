+"""Every external input of a validation run, by immutable identifier.
+
+Hashes were read from the publishers' own records on 2026-10-16: the Ubuntu cloud image from the dated release
+directory's SHA256SUMS, runc from the Ubuntu archive's Packages index (noble-updates; 1.3.4 carries the 2025 runc
+container-escape fixes that the noble release pocket's 1.1.12 lacks), gVisor from its release bucket's own .sha512.
+A pin that no longer resolves fails closed; it is never replaced by "latest".
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+
+GUEST_IMAGE = {
+    "name": "ubuntu-24.04-server-cloudimg-amd64.img", "release": "noble/release-20260911",
+    "url": "https://cloud-images.ubuntu.com/releases/noble/release-20260911/ubuntu-24.04-server-cloudimg-amd64.img",
+    "sha256": "612b2c0cc1bc413a6cb8c38fd611794caf0f2b436c50013d8b3794db12ad7354"}
+RUNC = {
+    "name": "runc", "version": "1.3.4-0ubuntu1~24.04.1", "source": "Ubuntu archive noble-updates",
+    "url": "http://archive.ubuntu.com/ubuntu/pool/main/r/runc-app/runc_1.3.4-0ubuntu1~24.04.1_amd64.deb",
+    "sha256": "6ddd64ed7ef1693dd95620a2b1148a4187ef4fe0819c3c3049fad9385ecfd5dc"}
+GVISOR = {
+    "name": "runsc", "version": "release-20260914.0", "source": "gVisor release bucket",
+    "url": "https://storage.googleapis.com/gvisor/releases/release/20260914.0/x86_64/gvisor.tar.bz2",
+    "sha512": "ff1c0577c8daa0e3511aedad554c3d5e20fa184b4ddd422454f573d60a8b9774f972755ca5c7f56588c5b4f42345b60b2ead077f35d7d3235e23f57c0fa194ca"}
+PYCDLIB = {
+    "name": "pycdlib", "version": "1.20.0", "file": "pycdlib-1.20.0-py2.py3-none-any.whl",
+    "sha256": "cb675959dd6d61e94f02560ed7e9a5d368a3188b5f7f31813bc25a750cff0863"}
+QEMU = {"package": "qemu-system-x86", "provider": "Ubuntu archive (apt verifies the archive signature)",
+        "note": "installed version is recorded in the run; the guest, not QEMU, is the tested boundary"}
+ACTIONS = {
+    "actions/checkout": "11d5960a326750d5838078e36cf38b85af677262",          # v4.4.0
+    "actions/setup-python": "a26af69be951a213d495a4c3e4e4022e16d87065",      # v5.6.0
+    "actions/upload-artifact": "ea165f8d65b6e75b540449e92b4886f43607fa02",   # v4.6.2
+    "actions/download-artifact": "d3f86a106a0bac45b974a628896c90dbdf5c8093",  # v4.3.0
+}
+
+
+def all_pins() -> dict:
+    from foundry.systems import containers
+    return {"guest_image": GUEST_IMAGE, "runc": RUNC, "gvisor": GVISOR, "pycdlib": PYCDLIB, "qemu": QEMU,
+            "actions": ACTIONS, "base_image": containers.BASE}
+
+
+def pins_digest() -> str:
+    return "sha256:" + hashlib.sha256(json.dumps(all_pins(), sort_keys=True, separators=(",", ":")).encode()).hexdigest()
