{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.uniimente.internal/trustrail/settlement-receipt.v1.json",
  "title": "Settlement Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "intent_id", "adapter_id", "external_reference", "idempotency_key", "payer", "payee", "amount", "currency", "status", "reality_status", "received_at", "raw_receipt_hash", "reconciled"],
  "properties": {
    "receipt_id": {"type": "string", "format": "uuid"},
    "intent_id": {"type": "string", "format": "uuid"},
    "adapter_id": {"type": "string"},
    "external_reference": {"type": "string"},
    "idempotency_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "payer": {"type": "string"},
    "payee": {"type": "string"},
    "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "currency": {"type": "string"},
    "status": {"enum": ["succeeded", "failed", "pending", "reversed"]},
    "reality_status": {"enum": ["LIVE", "SANDBOX", "SIMULATED", "PROPOSED"]},
    "received_at": {"type": "string", "format": "date-time"},
    "raw_receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reconciled": {"type": "boolean"}
  }
}
