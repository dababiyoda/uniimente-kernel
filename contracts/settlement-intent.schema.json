{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.uniimente.internal/trustrail/settlement-intent.v1.json",
  "title": "Settlement Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent_id", "credential_id", "authorization_id", "requested_by", "legal_principal", "payer", "payee", "amount", "currency", "purpose", "adapter_id", "idempotency_key", "reality_status", "created_at", "state"],
  "properties": {
    "intent_id": {"type": "string", "format": "uuid"},
    "credential_id": {"type": "string", "format": "uuid"},
    "authorization_id": {"type": "string", "format": "uuid"},
    "requested_by": {"type": "string", "minLength": 1},
    "legal_principal": {"type": "string", "minLength": 1},
    "payer": {"type": "string", "minLength": 1},
    "payee": {"type": "string", "minLength": 1},
    "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "currency": {"type": "string"},
    "purpose": {"type": "string"},
    "adapter_id": {"type": "string"},
    "idempotency_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reality_status": {"enum": ["LIVE", "SANDBOX", "SIMULATED", "PROPOSED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["authorized", "submitted", "reconciled", "failed", "disputed", "reversed"]}
  }
}
