+    # The interpreter's system site-packages hold the published modules a worker imports after
+    # confinement; on Debian-style Pythons they sit outside sys.prefix/lib (/usr/local/lib/.../
+    # dist-packages). User site and arbitrary sys.path roots stay excluded.
+    import site
+    for directory in site.getsitepackages():
+        directory = Path(directory)
+        if directory.is_dir():
