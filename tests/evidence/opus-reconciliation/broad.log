        def formats(node):
            if isinstance(node, dict):
                if 'format' in node:
                    yield node['format']
                for value in node.values():
                    yield from formats(value)
            elif isinstance(node, list):
                for value in node:
                    yield from formats(value)
        missing = set(formats(schema)) - checker.checkers.keys()
