+    # glibc's companion libraries live beside the loaded libc; an extension module imported after
+    # confinement may link one (librt.so.1 on a CI runner whose Python lives outside /usr/lib).
+    for directory in {path.parent for path in list(grants) if path.name.startswith("libc.so")}:
+        for pattern in ("librt.so*", "libpthread.so*", "libdl.so*", "libm.so*", "libutil.so*"):
+            for path in directory.glob(pattern):
