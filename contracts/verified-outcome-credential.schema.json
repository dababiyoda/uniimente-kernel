{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.uniimente.internal/trustrail/verified-outcome-credential.v1.json",
  "title": "Verified Outcome Credential",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "id", "type", "issuer", "validFrom", "validUntil", "credentialSubject", "credentialStatus", "proof"],
  "properties": {
    "@context": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "id": {"type": "string", "pattern": "^urn:uuid:"},
    "type": {"type": "array", "contains": {"const": "VerifiedOutcomeCredential"}},
    "issuer": {"type": "string", "minLength": 1},
    "validFrom": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "credentialSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "actorId", "legalPrincipal", "actionClass", "verifierId", "outcomeHash", "receiptHash", "witnessId", "evidenceRefs", "policyVersion", "verificationResult", "realityStatus"],
      "properties": {
        "actionId": {"type": "string", "format": "uuid"},
        "actorId": {"type": "string", "minLength": 1},
        "legalPrincipal": {"type": "string", "minLength": 1},
        "actionClass": {"type": "string", "minLength": 1},
        "verifierId": {"type": "string", "minLength": 1},
        "outcomeHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "receiptHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "witnessId": {"type": "string", "format": "uuid"},
        "evidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "policyVersion": {"type": "string", "minLength": 1},
        "verificationResult": {"const": "accepted"},
        "realityStatus": {"enum": ["LIVE", "SANDBOX", "SIMULATED", "PROPOSED"]}
      }
    },
    "credentialStatus": {
      "type": "object",
      "required": ["id", "type", "status"],
      "properties": {
        "id": {"type": "string"},
        "type": {"const": "UniimenteCredentialStatus"},
        "status": {"enum": ["active", "suspended", "revoked"]}
      }
    },
    "proof": {
      "type": "object",
      "required": ["type", "created", "verificationMethod", "proofValue"],
      "properties": {
        "type": {"type": "string"},
        "created": {"type": "string", "format": "date-time"},
        "verificationMethod": {"type": "string"},
        "proofValue": {"type": "string", "minLength": 1}
      }
    }
  }
}
