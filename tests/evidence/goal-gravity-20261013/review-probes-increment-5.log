# ---- adapter: adapt.py
"""Adapt the reviewers' probe scripts (written against 54fd20cc's API) to the fixed API, changing nothing else.

- quarantine_complete_record=True  -> acknowledged_risks=("unanchored", "complete_record")
- a recover_torn_tail(...) call with neither expected_head, acknowledged_risks nor **kwargs gets
  acknowledged_risks=("unanchored",) -- the most permissive setting a careless operator would pass
- a hand-written tail that is not the prefix of a real serialized record ('{"seq": 2, "re...') is rewritten to the real
  prefix order ('{"seq": 2, "ts_utc": "..."...') so the probe exercises its finding instead of the corruption refusal
"""
import re, sys
src = open(sys.argv[1]).read()
src = src.replace('{"quarantine_complete_record": True}', "{'acknowledged_risks': ('unanchored', 'complete_record')}")
src = src.replace('quarantine_complete_record=True', "acknowledged_risks=('unanchored', 'complete_record')")
src = re.sub(r"""b'\{"seq": (\d+), "re""", r"""b'{"seq": \1, "ts_utc": "2026-11-13T12:00:00Z", "re""", src)
out, i = [], 0
for m in re.finditer(r"recover_torn_tail\(", src):
    if m.start() < i:
        continue
    j, depth = m.end(), 1
    while depth:
        c = src[j]; depth += (c == "(") - (c == ")"); j += 1
    call = src[m.start():j]
    if not any(k in call for k in ("expected_head", "acknowledged_risks", "**")) and "def " not in src[max(0, m.start()-4):m.start()]:
        call = call[:-1] + ", acknowledged_risks=('unanchored',))"
    out.append(src[i:m.start()]); out.append(call); i = j
out.append(src[i:])
sys.stdout.write("".join(out))
# ---- fixture patches: patch_fixtures.py
"""Per-probe fixture patches for the replay (run from review-recovery/). Each is an exact, asserted replacement."""


def patch(path, old, new):
    s = open(path).read()
    assert old in s, (path, old)
    open(path, "w").write(s.replace(old, new))


# r2 part A asserted the body OPENED inside the old unlocked window; record what the body reports instead
patch("crash-concurrency/r2_window_race.replay.py",
      '''        assert proc.stdout.readline().strip() == "OPENED"
        state["proc"] = proc''',
      '''        state["proc"] = proc
        state["line"] = proc.stdout.readline().strip()
        print("[A] restarting body, started inside the former window, reports:", state["line"])''')

# r4 and v12 hard-coded the seq of a later tear; seq starts at 0 (genesis), so the next seq is the line count
patch("crash-concurrency/r4_poisoned_sidecar_future.replay.py",
      """t2 = b'{"seq": 3, "ts_utc": "y%d' % trial""",
      """t2 = b'{"seq": %d, "ts_utc": "y%d' % (open(path, "rb").read().count(b"\\n"), trial)""")
patch("crash-concurrency/r4_poisoned_sidecar_future.replay.py",
      """    try:
        recovery.recover_torn_tail(path, ANCHOR, recovered_by="ops", reason="retry 1\"""",
      """    r1 = "ok"
    try:
        recovery.recover_torn_tail(path, ANCHOR, recovered_by="ops", reason="retry 1\"""")
patch("crash-concurrency-verify/v12_partial_files.replay.py",
      """fh.write(b'{"seq": 3, "ts_utc": "2026-11-13T13:00:00Z", "pay')""",
      """fh.write(b'{"seq": %d, "ts_utc": "2026-11-13T13:00:00Z", "pay' % open(path, "rb").read().count(b"\\n"))""")
print("fixture patches applied")
# ---- driver: regen.sh
#!/bin/sh
# Regenerate every *.replay.py from the reviewers' original probe and apply the per-probe harness patches.
# The patches change only what the old API or a hand-written fixture made inapplicable; each is listed here.
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE/../review-recovery"
for f in evidence-integrity/*.py crash-concurrency/*.py crash-concurrency-verify/*.py semantics-honesty/r*/*.py semantics-honesty-verify/f*/*.py; do
  case $f in *common.py|*probes.py|*.replay.py|*/contender*.py) continue;; esac
  python3 "$HERE/adapt.py" "$f" > "${f%.py}.replay.py"
done
K=/home/user/uniimente-kernel
# 1. the semantics probes loaded 54fd20cc through preload_commit; the replay loads the fixed module from the repo
for f in semantics-honesty/r*/*.replay.py semantics-honesty-verify/f*/*.replay.py; do
  sed -i "s#^import preload_commit.*\$#sys.path.insert(0, '$K')  \# replay: fixed provenance.recovery, not 54fd20cc#" "$f"
  sed -i 's/import preload_commit; //' "$f"
done
# 2. the fixed API has no unacknowledged_proof; its replacement fields are acknowledged_risks and anchor
for f in crash-concurrency/r3_stale_sidecar.replay.py semantics-honesty/r1/stale_checkpoint_proof.replay.py \
         evidence-integrity/c_e2e_redispatch.replay.py crash-concurrency-verify/v4_stale_proof.replay.py; do
  sed -i "s/\[\"unacknowledged_proof\"\]/.get(\"acknowledged_risks\")/g; s/\['unacknowledged_proof'\]/.get('acknowledged_risks')/g; s/\.get(\"unacknowledged_proof\")/.get(\"acknowledged_risks\")/g" "$f"
done
# 3. per-probe fixture patches
python3 "$HERE/patch_fixtures.py"
