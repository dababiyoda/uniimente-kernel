{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniimente.example/contracts/cortex-intelligence-genome.schema.json",
  "title": "Cortex IntelligenceGenome v0.1 (cognitive projection of a CapabilityGenome)",
  "description": "A CapabilityGenome registered in the one Kernel GenomeRegistry plus a cognitive profile keyed by the same name@version. Execution envelope is read_only; the light cone observes and never modifies. Benchmark history holds references only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "capability",
    "profile"
  ],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capability": {
      "type": "object",
      "required": [
        "name",
        "version",
        "description",
        "interface",
        "contracts",
        "authority",
        "acceptance_tests",
        "failure_modes",
        "recovery_path",
        "legal_operator"
      ],
      "properties": {
        "authority": {
          "type": "object",
          "required": [
            "max_consequence_class",
            "budget_ceiling_usd",
            "requires_human"
          ],
          "properties": {
            "max_consequence_class": {
              "const": "read_only"
            }
          }
        },
        "legal_operator": {
          "not": {
            "const": "UNIIMENTE"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "layer",
        "supported_geometries",
        "input_contract",
        "output_contract",
        "proof_classes",
        "observations",
        "state",
        "memory_scope",
        "update_rules",
        "recruitment",
        "inhibition",
        "evidence_requirements",
        "cost_usd_per_call",
        "latency_s_budget",
        "cognitive_light_cone",
        "authority_ref",
        "contraindications",
        "abstention_conditions",
        "failure_modes",
        "lineage",
        "benchmark_history",
        "failure_diversity_key",
        "shared_dependencies",
        "lifecycle",
        "enabled",
        "biological_concept"
      ],
      "properties": {
        "role": {
          "enum": [
            "solver",
            "verifier",
            "reserved"
          ]
        },
        "layer": {
          "enum": [
            "primitive_basal",
            "distributed_collective",
            "solver_macro_cognitive",
            "developmental_morphogenetic",
            "meta_polyintelligence_cortex"
          ]
        },
        "supported_geometries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "deductive_logical",
              "arithmetic",
              "constraint_feasibility",
              "optimization",
              "estimate",
              "prediction",
              "causal",
              "semantic",
              "strategic",
              "normative_value",
              "legal",
              "physical_perceptual",
              "institutional_acceptance"
            ]
          }
        },
        "proof_classes": {
          "type": "array",
          "items": {
            "enum": [
              "semantic_sourced",
              "estimation",
              "formal",
              "evidence_assessment",
              "causal_estimate",
              "gate_report",
              "verifier_findings",
              "optimization",
              "bayesian",
              "simulation",
              "human_adjudication",
              "measurement",
              "institutional_observation"
            ]
          }
        },
        "cost_usd_per_call": {
          "type": "number",
          "minimum": 0
        },
        "latency_s_budget": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cognitive_light_cone": {
          "type": "object",
          "required": [
            "observes",
            "modifies",
            "max_informed_consequence",
            "horizon"
          ],
          "properties": {
            "modifies": {
              "type": "array",
              "maxItems": 0
            },
            "max_informed_consequence": {
              "enum": [
                "read_only",
                "internal_write",
                "external_contact",
                "financial",
                "irreversible"
              ]
            }
          }
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "enum": [
            "DISCOVERED",
            "SPECIFIED",
            "WRAPPED",
            "TESTED",
            "SANDBOXED",
            "SHADOW",
            "CANARY",
            "ACTIVE",
            "SPECIALIZED",
            "FALLBACK",
            "SUPERSEDED",
            "HISTORICAL",
            "QUARANTINED"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "benchmark_history": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_diversity_key": {
          "type": "string",
          "minLength": 1
        },
        "biological_concept": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "mechanism",
                "state_variables",
                "interface",
                "feedback_loop",
                "measurable_behavior",
                "test",
                "failure_condition"
              ],
              "properties": {
                "mechanism": {
                  "type": "string",
                  "minLength": 1
                },
                "state_variables": {
                  "type": "string",
                  "minLength": 1
                },
                "interface": {
                  "type": "string",
                  "minLength": 1
                },
                "feedback_loop": {
                  "type": "string",
                  "minLength": 1
                },
                "measurable_behavior": {
                  "type": "string",
                  "minLength": 1
                },
                "test": {
                  "type": "string",
                  "minLength": 1
                },
                "failure_condition": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "input_contract": {
          "type": "object"
        },
        "output_contract": {
          "type": "object"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "type": "string"
        },
        "memory_scope": {
          "type": "string"
        },
        "update_rules": {
          "type": "string"
        },
        "recruitment": {
          "type": "string"
        },
        "inhibition": {
          "type": "string"
        },
        "evidence_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contraindications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "abstention_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "failure_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "lineage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shared_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
