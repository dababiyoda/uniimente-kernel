// Sovereignty hierarchy. Higher rank wins every conflict.
// UCL v0.1. Part of the UNIIMENTE Constitution.

sovereignty_hierarchy "uniimente" {
    // Rank 1 is highest. A lower rule may never override a higher one.
    level { rank = 1  name = "law_safety_rights"            owner = "external"   description = "Applicable law, physical safety, and fundamental participant rights" }
    level { rank = 2  name = "alfonso_reserved_authority"   owner = "alfonso"    description = "Alfonso's lawful ownership, shutdown, amendment, and reserved authority" }
    level { rank = 3  name = "constitution"                 owner = "constitution" description = "The UNIIMENTE Constitution as ratified" }
    level { rank = 4  name = "binding_duties"               owner = "legal"      description = "Binding contractual, regulatory, fiduciary, and entity-specific duties" }
    level { rank = 5  name = "approved_objectives"          owner = "alfonso"    description = "Approved institutional objectives" }
    level { rank = 6  name = "portfolio_policies"           owner = "portfolio_governor" description = "Portfolio policies and capital limits" }
    level { rank = 7  name = "venture_cell_charters"        owner = "kernel"     description = "Venture Cell charters" }
    level { rank = 8  name = "capability_grants"            owner = "kernel"     description = "Capability grants" }
    level { rank = 9  name = "workflow_instructions"        owner = "plan_executor" description = "Workflow instructions" }
    level { rank = 10 name = "individual_tasks"             owner = "agents"     description = "Individual tasks" }
}

policy "conflict_resolution" {
    rule = "On any conflict between levels, the lower-ranked instruction is suspended and the conflict escalates to the owner of the higher level."
    prevents = [
        "agents overriding Alfonso under a vague claim of protecting him",
        "momentary instructions conflicting with law, contracts, participant rights, or Alfonso's documented durable interests"
    ]
}

reserved_authority "alfonso" {
    // Rank 2. Always exercisable, never delegable, never expirable.
    powers = [
        "shutdown_any_or_all_components",
        "amend_constitution_via_ceremony",
        "revoke_any_grant_at_any_time",
        "final_decision_on_reserved_matters",
        "capital_authority",
        "read_any_record"
    ]
    note = "The institution may disarm but never self-arm. Alfonso arms."
}
