{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniimente.internal/contracts/context-packet.schema.json",
  "title": "ContextPacket",
  "description": "Shared normalized sensor output. All perception organs emit ContextPackets; selectors prioritize them over raw keywords.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "packet_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "enum": [
        "feedly",
        "x",
        "linkedin",
        "mastodon",
        "video",
        "self_history",
        "analytics",
        "railscout",
        "manual",
        "other"
      ]
    },
    "raw_ref": {
      "type": "string",
      "description": "Reference to preserved raw material"
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "topic": {
      "type": [
        "string",
        "null"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stakes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "incentives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_cost": {
      "type": [
        "string",
        "null"
      ]
    },
    "system_failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_needed": {
      "type": "boolean"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "recommended_action": {
      "type": "string",
      "enum": [
        "ignore",
        "save",
        "research_first",
        "reply",
        "post",
        "human_review"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC timestamp"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          }
        },
        "sanitized": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "evidence_refs",
        "sanitized"
      ]
    }
  },
  "required": [
    "packet_id",
    "source",
    "raw_ref",
    "claims",
    "evidence_needed",
    "risk",
    "recommended_action",
    "confidence",
    "created_at",
    "provenance"
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
