{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.uniimente.internal/trustrail/verifier-attestation.v1.json",
  "title": "Verifier Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_id", "verifier_id", "action_id", "outcome_hash",
    "receipt_hash", "decision", "evidence_refs", "policy_version",
    "observed_at", "expires_at", "reality_status", "signature"
  ],
  "properties": {
    "attestation_id": {"type": "string", "format": "uuid"},
    "verifier_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "format": "uuid"},
    "outcome_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision": {"enum": ["accepted", "rejected", "disputed"]},
    "evidence_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "policy_version": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "reality_status": {"enum": ["LIVE", "SANDBOX", "SIMULATED", "PROPOSED"]},
    "signature": {"type": "string", "minLength": 1}
  }
}
