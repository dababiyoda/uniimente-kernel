{
 "rulebook": "carrier-load-payment",
 "version": "1",
 "label": "SYNTHETIC — not a real party. A sandbox rulebook for a carrier's request to be paid for a delivered load; it describes no real payer.",
 "case_reference": "load_reference",
 "request": {"channel": "carrier-requests"},
 "documents": {
  "rate_confirmation": {"file": "rate_confirmation.txt", "required": true},
  "bill_of_lading": {"file": "bill_of_lading.txt", "required": true},
  "proof_of_delivery": {"file": "proof_of_delivery.txt", "required": true},
  "invoice": {"file": "invoice.txt", "required": true},
  "exception_notice": {"file": "exception_notice.txt", "required": false},
  "acceptance": {"file": "acceptance.txt", "required": false}
 },
 "facts": {
  "load_reference": {"type": "text", "from": {"rate_confirmation": "Load reference", "bill_of_lading": "Load reference",
                                              "proof_of_delivery": "Load reference", "invoice": "Load reference"}},
  "signed_reference": {"type": "text", "from": {"mission": "reference"}},
  "agreed_amount": {"type": "amount", "from": {"rate_confirmation": "Agreed amount", "invoice": "Agreed amount"}},
  "currency": {"type": "text", "from": {"rate_confirmation": "Currency", "invoice": "Currency"}},
  "delivery_window_start": {"type": "date", "from": {"rate_confirmation": "Delivery window start"}},
  "delivery_window_end": {"type": "date", "from": {"rate_confirmation": "Delivery window end"}},
  "consignee": {"type": "text", "from": {"rate_confirmation": "Consignee", "bill_of_lading": "Consignee"}},
  "pieces": {"type": "number", "from": {"bill_of_lading": "Pieces"}},
  "delivered_date": {"type": "date", "from": {"proof_of_delivery": "Delivered date"}},
  "receiver": {"type": "text", "from": {"proof_of_delivery": "Received by"}},
  "pod_signed": {"type": "yes_no", "from": {"proof_of_delivery": "Signed"}},
  "pod_exceptions": {"type": "text", "from": {"proof_of_delivery": "Exceptions"}},
  "invoice_amount": {"type": "amount", "from": {"invoice": "Invoice amount"}},
  "accessorials": {"type": "amount", "many": true, "from": {"invoice": "Accessorial"},
                   "pattern": "(?P<value>\\d[\\d,]*\\.\\d{2})"},
  "approved_accessorials": {"type": "amount", "many": true, "from": {"invoice": "Accessorial"},
                            "pattern": "(?P<value>\\d[\\d,]*\\.\\d{2})", "only": "approval\\s+[A-Z0-9-]{3,}"},
  "exception_status": {"type": "text", "from": {"exception_notice": "Status"}, "values": ["open", "closed"]},
  "exception_detail": {"type": "text", "from": {"exception_notice": "Exception"}},
  "completion": {"type": "text", "from": {"acceptance": "Completion"}},
  "dispute_reason": {"type": "text", "from": {"acceptance": "Dispute"}},
  "earlier_cases": {"type": "number", "from": {"ledger": "earlier cases"}}
 },
 "rules": [
  {"id": "documents-agree-on-load",
   "description": "every required document is on file and carries the same load reference, the one signed with the mission",
   "needs": {"load_reference": ["rate_confirmation", "bill_of_lading", "proof_of_delivery", "invoice"],
             "signed_reference": ["mission"]},
   "condition": "load_reference == signed_reference"},
  {"id": "delivered-signed-in-window",
   "description": "the proof of delivery is signed and dated inside the delivery window",
   "needs": {"pod_signed": ["proof_of_delivery"], "delivered_date": ["proof_of_delivery"],
             "delivery_window_start": ["rate_confirmation"], "delivery_window_end": ["rate_confirmation"]},
   "condition": "pod_signed == True and delivery_window_start <= delivered_date <= delivery_window_end"},
  {"id": "no-open-exception",
   "description": "no exception was noted at delivery and no exception notice is open",
   "needs": {"pod_exceptions": ["proof_of_delivery"], "exception_status": ["exception_notice"]},
   "condition": "pod_exceptions in ('none', 'no exceptions') and exception_status != 'open'"},
  {"id": "invoice-matches-agreement",
   "description": "the invoice amount is the agreed amount plus the accessorials that carry an approval",
   "needs": {"invoice_amount": ["invoice"], "agreed_amount": ["rate_confirmation"],
             "approved_accessorials": ["invoice"]},
   "condition": "invoice_amount == agreed_amount + sum(approved_accessorials)"},
  {"id": "not-a-duplicate",
   "description": "no earlier request with the same load reference is open or settled",
   "needs": {"earlier_cases": ["ledger"]},
   "condition": "earlier_cases == 0"}
 ],
 "disputes": [
  {"id": "completion-disputed", "description": "the receiver disputes that the work was completed",
   "needs": {"completion": ["acceptance"]}, "condition": "completion == 'disputed'", "name": "dispute_reason"}
 ],
 "acceptance": {"description": "the receiver's written acceptance says completion is accepted",
                "needs": {"completion": ["acceptance"]}, "condition": "completion == 'accepted'"},
 "settlement": {"amount": "invoice_amount", "currency": "currency"},
 "estimate": ["agreed_amount", "approved_accessorials", "invoice_amount"],
 "routing": [
  {"state": "ineligible", "route": "decline", "action": "decline the request, citing the rule that is not met; a person tells the requester"},
  {"state": "disputed", "route": "hold", "action": "hold the case and name the dispute; a person settles it with the parties"},
  {"state": "undetermined", "route": "ask", "action": "ask the requester for exactly the missing facts"},
  {"state": "eligible", "route": "settle", "action": "prepare settlement and wait for the payment to be observed; the payment itself is a person's act"}
 ]
}
