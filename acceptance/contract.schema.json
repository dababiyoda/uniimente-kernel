{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniimente.internal/acceptance/contract.schema.json",
  "title": "Full-machine completion contract (directive 2026-10-13 section 35)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "boundary", "functions", "current_machine_conditions"],
  "properties": {
    "version": {"const": "completion-contract/1"},
    "boundary": {"type": "string", "minLength": 1},
    "functions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/function"}},
    "current_machine_conditions": {
      "type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/condition"}
    }
  },
  "$defs": {
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer", "function", "founder_intent", "owner", "owner_paths", "source", "interface",
                   "implementation", "integration", "evidence", "authority", "missing_dependencies",
                   "observed_failures", "recovery", "resources", "next_work", "blocking"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
        "layer": {"enum": ["Body", "Mind", "Organs", "Loop"]},
        "function": {"type": "string", "minLength": 1},
        "founder_intent": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "owner": {"type": "string", "minLength": 1},
        "owner_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source": {"type": "string", "minLength": 1},
        "interface": {"type": "string", "minLength": 1},
        "implementation": {"enum": ["INTENDED", "DESIGNED", "IMPLEMENTED", "BLOCKED_WITH_REASON"]},
        "integration": {"enum": ["NOT_INTEGRATED", "PARTIAL", "INTEGRATED"]},
        "evidence": {"type": "array", "items": {"type": "string", "pattern": "^[A-L]\\.[A-Za-z0-9.]+$"}},
        "authority": {"type": "string", "minLength": 1},
        "missing_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "observed_failures": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "recovery": {"type": "string", "minLength": 1},
        "resources": {"type": "string", "minLength": 1},
        "next_work": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "blocking": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "condition", "met", "evidence"],
      "properties": {
        "n": {"type": "integer", "minimum": 1, "maximum": 15},
        "condition": {"type": "string", "minLength": 1},
        "met": {"enum": ["yes", "partly", "no"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
