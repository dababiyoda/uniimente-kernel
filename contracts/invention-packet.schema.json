{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniimente.internal/contracts/invention-packet.schema.json",
  "title": "InventionPacket",
  "description": "Founder-intent-preserving problem packet for a designated novelty model. The packet requests proposals only and grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonempty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "properties": {
    "packet_id": {"$ref": "#/$defs/sha256"},
    "request_id": {"type": "string", "minLength": 1},
    "assigned_model_id": {"type": "string", "minLength": 1},
    "founder_intent_ref": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "current_architecture_refs": {"$ref": "#/$defs/nonempty_strings"},
    "protected_invariants": {"$ref": "#/$defs/nonempty_strings"},
    "unresolved_contradiction": {"type": "string", "minLength": 1},
    "required_routes": {
      "type": "array",
      "minItems": 6,
      "contains": {"const": "one do-nothing alternative"},
      "items": {"type": "string", "minLength": 1}
    },
    "adversarial_obligations": {"$ref": "#/$defs/nonempty_strings"},
    "integration_outputs": {"$ref": "#/$defs/nonempty_strings"},
    "authority_status": {"const": "PROPOSED_NOT_EXECUTED"}
  },
  "required": [
    "packet_id",
    "request_id",
    "assigned_model_id",
    "founder_intent_ref",
    "objective",
    "current_architecture_refs",
    "protected_invariants",
    "unresolved_contradiction",
    "required_routes",
    "adversarial_obligations",
    "integration_outputs",
    "authority_status"
  ]
}
