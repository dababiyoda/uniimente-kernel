diff --git a/greg/body.py b/greg/body.py
index 5892d41..eb93b23 100644
--- a/greg/body.py
+++ b/greg/body.py
@@ -380,6 +380,17 @@ class Body:
                 return anchor.configure(self.journal, body, digest)
             except anchor.AnchorError as exc:
                 raise MissionError(str(exc)) from None
+        if kind == "VALIDATION_GRANT":
+            from foundry.validation import grant as validation_grant
+            try:
+                granted = validation_grant.validate(body)
+            except validation_grant.GrantError as exc:
+                raise MissionError(str(exc)) from None
+            # Expiry, nonce and signer stay on the command.accepted record of the same digest.
+            record = {"grant": granted, "command_digest": digest, "at": iso(self.clock())}
+            self.journal.record("validation.granted", record, key=digest)
+            return {"granted": granted["source_revision"], "max_runs": granted["resources"]["max_runs"],
+                    "grant_digest": digest}
         if kind == "ROTATE_FOUNDER_KEY":
             new_hex = body["new_public_key"]
             old = next(iter(self.enrolled_keys()))
