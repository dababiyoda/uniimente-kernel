{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniimente.internal/contracts/greg-mission.schema.json",
  "title": "GREG persistent mission (founder-signed MISSION command body)",
  "description": "A durable target state, the checks that observe it, candidate strategies, and the bounded light cone inside which GREG may pursue it. Registration grants no authority; every action still crosses the Kernel Consequence Gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "founder_expression",
    "intended_effect",
    "closure",
    "success_checks",
    "strategies",
    "light_cone",
    "priority"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "pattern": "^m:[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "founder_expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "intended_effect": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "beneficiaries": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "maxItems": 50
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "unacceptable_outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "bounded",
            "infinite"
          ]
        },
        "ladder": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "maxItems": 100
        },
        "cadence_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        }
      }
    },
    "success_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "description",
          "sensor",
          "predicate"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]{1,80}$"
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "sensor": {
            "$ref": "#/$defs/invocation"
          },
          "predicate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "exists",
                  "absent",
                  "equals",
                  "contains",
                  "not_contains",
                  "gte",
                  "lte",
                  "count_gte"
                ]
              },
              "field": {
                "type": "string",
                "maxLength": 200
              },
              "value": {}
            }
          }
        }
      }
    },
    "strategies": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "advances",
          "target",
          "rationale"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]{1,80}$"
          },
          "capability": {
            "type": "string",
            "maxLength": 120
          },
          "function": {
            "type": "string",
            "maxLength": 120
          },
          "params": {
            "type": "object"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "advances": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000
          },
          "expected_outcome": {
            "type": "string",
            "maxLength": 500
          },
          "evidence_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "light_cone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "targets",
        "max_consequence_class",
        "budget_usd",
        "horizon"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 200
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "minItems": 1,
          "maxItems": 200
        },
        "max_consequence_class": {
          "enum": [
            "read_only",
            "internal_write",
            "external_contact"
          ]
        },
        "budget_usd": {
          "type": "number",
          "minimum": 0
        },
        "horizon": {
          "type": "string",
          "format": "date-time"
        },
        "data_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "auto_attach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_consequence_class"
      ],
      "properties": {
        "max_consequence_class": {
          "enum": [
            "read_only"
          ]
        }
      }
    },
    "value_per_check_usd": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000,
      "description": "Founder-stated value of closing one failing check, used only to rank strategies against spend."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "planner"
      ],
      "description": "How this mission proposal was produced (template or model). Founder-signed as part of the body; it is attribution, never authority.",
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 200
        },
        "planner": {
          "type": "string",
          "maxLength": 100
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "clamped": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "maxItems": 20
        },
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    }
  },
  "$defs": {
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "maxLength": 120
        },
        "function": {
          "type": "string",
          "maxLength": 120
        },
        "params": {
          "type": "object"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
